🏚️ globals  
    🎃 always = 1
    🎃 pi     = 3.141592

👻 fib
    🕸️ n
    🍭 nle(n,1) → n
    🍭 globals::always → nadd(
        fib|nsub(n,1),
        fib|nsub(n,2)
    )

👻 dummy
    🕸️ path
    🍭 not|exists|path → write("test.txt", "my data")

🏚️ main
    🍭 sprint|sadd("hello ", "world!")
    🎃 mylist = list(1,2,3)
    🍭 sprint|exec|"ls"
    🍭 nprint|get(mylist,0)
    🍭 nprint|fib(30)
    🎃 path = "test.txt" 
    🎃 path = "test.txt" 
    🍭 dummy(path)
    🍭 sprint|read|path