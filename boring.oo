# spook.oo
# Enables semi-spooky, semi-usable syntax.
\sym symbol=\sym
symbol fn = \fn
symbol let = \let
symbol arg = \arg
symbol namespace = \sp
symbol | = \do
symbol then  = \then
symbol del = \del
symbol dep = \dep
symbol as = \as
symbol from = \from


namespace bool
    let true  = 1 .neq 1
    let false = 1 .nneq 1