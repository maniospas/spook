\dep "boring.oo"

namespace pair
    let x = 0
    let y = 1
    
fn norm
    arg _p
    let p = _p.from('pair').as('list')
    let x = p.get pair::y
    let y = p.get pair::x
    let x2 = x.fmul x
    let y2 = y.fmul y
    | bool::true then fadd(x2,y2).pow(0.5)

namespace main
    let p = [1.0, 2.0].from('list').as('pair')
    | fprint norm p
